{
  "manifest_version": 3,
  "name": "VEIL — privacy firewall for browser agents",
  "version": "1.0.0",
  "description": "See locally. Reason remotely. Reveal nothing sensitive. On-device visual perception & privacy firewall for browser agents.",
  "permissions": ["activeTab", "tabs", "storage", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://huggingface.co/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "VEIL — Privacy Observatory"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": [
        "core/session.js",
        "core/security-ledger.js",
        "core/state-hasher.js",
        "core/kernel/protected-effects.js",
        "core/kernel/policy-decision-point.js",
        "core/kernel/taint-engine.js",
        "core/kernel/egress-firewall.js",
        "core/kernel/enforcement/dom-effect-gate.js",
        "core/kernel/enforcement/secret-release-gate.js",
        "core/kernel/enforcement/navigation-gate.js",
        "core/kernel/enforcement/storage-gate.js",
        "core/kernel/enforcement/clipboard-gate.js",
        "core/kernel/enforcement/network-effect-gate.js",
        "core/kernel/enforcement/effect-gate.js",
        "core/capability-manager.js",
        "core/kernel/transaction-engine.js",
        "core/policy-engine.js",
        "core/dom-utils.js",
        "core/detector.js",
        "core/visual-ocr.js",
        "core/perception-fusion.js",
        "core/network-forensics.js",
        "core/secret-vault.js",
        "core/failure-analyzer.js",
        "core/mutation-guard.js",
        "core/context-builder.js",
        "core/veil-ir.js",
        "core/privacy-audit.js",
        "core/risk-classifier.js",
        "core/action-resolver.js",
        "core/action-executor.js",
        "core/workflow-runner.js",
        "core/agent-orchestrator.js",
        "core/comparison-builder.js",
        "content/redactor.js",
        "content/high-risk-confirmation.js",
        "content/vision-fallback.js",
        "content/privacy-lens.js",
        "content/inspector-overlay.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/transformers.web.min.js",
        "command-center/command-center.html",
        "command-center/command-center.css",
        "command-center/command-center.js"
      ],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
